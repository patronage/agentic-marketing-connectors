{
  "name": "@patronage/example-claude-managed-agents",
  "version": "0.0.0",
  "private": true,
  "description": "Minimal Patronage Google Ads tool for Claude Managed Agents on Cloudflare",
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "start": "tsx --conditions=development src/local-preview.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.116.0",
    "@patronage/google-ads": "workspace:*",
    "agents": "0.20.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "tsx": "4.23.0",
    "typescript": "7.0.2",
    "wrangler": "4.110.0"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  }
}
