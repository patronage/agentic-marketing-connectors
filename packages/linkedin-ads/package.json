{
  "dependencies": {
    "@patronage/connector-lifecycle": "workspace:*"
  },
  "description": "Worker-safe LinkedIn Ads reporting and guarded mutation primitives for Patronage Core",
  "devDependencies": {
    "tsdown": "0.22.4",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./accounts": {
      "types": "./src/accounts.ts",
      "development": "./src/accounts.ts",
      "default": "./dist/accounts.js"
    },
    "./campaigns": {
      "types": "./src/campaigns.ts",
      "development": "./src/campaigns.ts",
      "default": "./dist/campaigns.js"
    },
    "./conversions": {
      "types": "./src/conversions.ts",
      "development": "./src/conversions.ts",
      "default": "./dist/conversions.js"
    },
    "./creatives": {
      "types": "./src/creatives.ts",
      "development": "./src/creatives.ts",
      "default": "./dist/creatives.js"
    },
    "./deployment": {
      "types": "./src/deployment.ts",
      "development": "./src/deployment.ts",
      "default": "./dist/deployment.js"
    },
    "./product": {
      "default": "./product.json"
    },
    "./reporting": {
      "types": "./src/reporting.ts",
      "development": "./src/reporting.ts",
      "default": "./dist/reporting.js"
    },
    "./targeting": {
      "types": "./src/targeting.ts",
      "development": "./src/targeting.ts",
      "default": "./dist/targeting.js"
    }
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "product.json",
    "README.md",
    "scripts/live-smoke.mjs"
  ],
  "license": "MIT",
  "name": "@patronage/linkedin-ads",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "directory": "packages/linkedin-ads",
    "type": "git",
    "url": "https://github.com/patronage/agentic-marketing-connectors.git"
  },
  "scripts": {
    "build": "tsdown",
    "smoke:live": "pnpm build && node scripts/live-smoke.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "type": "module",
  "version": "0.1.0"
}
