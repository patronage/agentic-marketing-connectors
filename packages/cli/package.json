{
  "bin": {
    "patronage": "./dist/index.js"
  },
  "dependencies": {
    "@patronage/google-ads": "workspace:*",
    "@patronage/linkedin-ads": "workspace:*",
    "@patronage/meta-ads": "workspace:*",
    "@patronage/meta-social": "workspace:*",
    "@patronage/x-posts": "workspace:*",
    "chalk": "5.6.2",
    "commander": "15.0.0",
    "dotenv": "17.4.2",
    "zod": "4.4.3"
  },
  "description": "Minimal local CLI harness for Patronage Open Source Core",
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsdown": "0.22.4",
    "tsx": "4.23.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "license": "MIT",
  "name": "@patronage/cli",
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.0.0"
}
