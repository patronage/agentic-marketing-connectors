{
  "bin": {
    "patronage": "./dist/index.js"
  },
  "dependencies": {
    "@patronage/google-ads": "workspace:*",
    "@patronage/linkedin-ads": "workspace:*",
    "@patronage/meta-ads": "workspace:*",
    "@patronage/meta-social": "workspace:*",
    "@patronage/x-posts": "workspace:*",
    "chalk": "5.6.2",
    "commander": "14.0.3",
    "dotenv": "17.3.1",
    "zod": "4.3.6"
  },
  "description": "Minimal local CLI harness for Patronage Open Source Core",
  "devDependencies": {
    "@types/node": "24.12.0",
    "tsdown": "0.21.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "exports": {
    ".": {
      "default": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "license": "MIT",
  "name": "@patronage/cli",
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.0.0"
}
