{
  "dependencies": {
    "@patronage/connector-lifecycle": "workspace:*"
  },
  "description": "Worker-safe TikTok Ads primitives for Patronage Core",
  "devDependencies": {
    "tsdown": "0.22.4",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.test.ts"
  ],
  "license": "MIT",
  "name": "@patronage/tiktok-ads",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "repository": {
    "directory": "packages/tiktok-ads",
    "type": "git",
    "url": "https://github.com/patronage/agentic-marketing-connectors.git"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "type": "module",
  "version": "0.1.0"
}
