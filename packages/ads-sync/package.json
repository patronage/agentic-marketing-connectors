{
  "dependencies": {
    "zod": "4.4.3"
  },
  "description": "Composable Ads Sync ingestion primitives for Cloudflare-hosted ad platform data pipelines.",
  "devDependencies": {
    "postgres": "^3.4.9",
    "tsdown": "0.22.4",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./google-ads": {
      "types": "./src/google-ads.ts",
      "default": "./dist/google-ads.mjs"
    },
    "./google-search-console": {
      "types": "./src/google-search-console.ts",
      "default": "./dist/google-search-console.mjs"
    },
    "./instance": {
      "types": "./src/instance.ts",
      "default": "./dist/instance.mjs"
    },
    "./meta-ads": {
      "types": "./src/meta-ads.ts",
      "default": "./dist/meta-ads.mjs"
    },
    "./providers": {
      "types": "./src/providers.ts",
      "default": "./dist/providers.mjs"
    },
    "./run": {
      "types": "./src/run.ts",
      "default": "./dist/run.mjs"
    },
    "./sql": {
      "types": "./src/sql.ts",
      "default": "./dist/sql.mjs"
    }
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/test-fixtures",
    "README.md"
  ],
  "license": "MIT",
  "name": "@patronage/ads-sync",
  "peerDependencies": {
    "postgres": "^3.4.9"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./google-ads": {
        "types": "./dist/google-ads.d.mts",
        "default": "./dist/google-ads.mjs"
      },
      "./google-search-console": {
        "types": "./dist/google-search-console.d.mts",
        "default": "./dist/google-search-console.mjs"
      },
      "./instance": {
        "types": "./dist/instance.d.mts",
        "default": "./dist/instance.mjs"
      },
      "./meta-ads": {
        "types": "./dist/meta-ads.d.mts",
        "default": "./dist/meta-ads.mjs"
      },
      "./providers": {
        "types": "./dist/providers.d.mts",
        "default": "./dist/providers.mjs"
      },
      "./run": {
        "types": "./dist/run.d.mts",
        "default": "./dist/run.mjs"
      },
      "./sql": {
        "types": "./dist/sql.d.mts",
        "default": "./dist/sql.mjs"
      }
    }
  },
  "repository": {
    "directory": "packages/ads-sync",
    "type": "git",
    "url": "https://github.com/patronage/agentic-marketing-connectors.git"
  },
  "scripts": {
    "build": "tsdown",
    "check": "pnpm build && pnpm typecheck && pnpm test",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.3.0"
}
